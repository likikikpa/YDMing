# Optional: run without Docker. Copy to /etc/systemd/system/ydming.service,
# adjust the paths, then: systemctl enable --now ydming
[Unit]
Description=YDMing map studio
After=network.target

[Service]
Type=simple
User=ydming
WorkingDirectory=/opt/ydming
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5173
Environment=TRUST_PROXY=1
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
