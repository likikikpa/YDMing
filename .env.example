# Copy to .env and edit. Used by docker compose.

# Your domain: Caddy gets and renews a free HTTPS certificate automatically.
# The domain's DNS A record must point at this server, and ports 80 and 443 must be open.
# Leave as :80 to serve plain HTTP on the server's IP address.
SITE_ADDRESS=:80

# Image search sends queries to Wikimedia Commons and Openverse.
# Set to "off" to disable it (the built-in sprite library keeps working).
ATLASFORGE_SEARCH=on

# Optional: an email or URL where Wikimedia can reach you if your server misbehaves.
ATLASFORGE_CONTACT=
