{
  "name": "atlasforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An offline fantasy map studio with world, city, and dungeon generators.",
  "author": "Atlasforge",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.mjs",
    "test": "vitest run && npm run test:server",
    "test:server": "node --test tests/server.test.mjs",
    "check:paths": "node scripts/check-paths.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "import:srd": "node scripts/import-srd.mjs"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.5"
  }
}
